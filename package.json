{
    "name": "jqtree",
    "version": "1.9.0",
    "description": "Tree widget for jQuery",
    "keywords": [
        "jquery-plugin",
        "tree"
    ],
    "license": "Apache-2.0",
    "browser": "./tree.jquery.js",
    "main": "./tree.jquery.js",
    "types": "./src/tree.jquery.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mbraak/jqtree.git"
    },
    "scripts": {
        "ci": "pnpm lint && pnpm tsc && pnpm test",
        "vitest": "vitest run --coverage --config test/vitest.config.ts",
        "vitest-watch": "vitest --config test/vitest.config.ts",
        "lint": "eslint src playwright test",
        "production": "./config/production",
        "devserver": "SERVE=true rollup --config config/rollup.config.mjs --watch",
        "devserver-with-coverage": "COVERAGE=true SERVE=true rollup --config config/rollup.config.mjs",
        "build-with-coverage": "COVERAGE=true rollup --config config/rollup.config.mjs",
        "prettier": "prettier src/*.ts --write --tab-width 4",
        "tsc": "tsc --noEmit --project tsconfig.json",
        "playwright": "pnpm build-with-coverage && playwright test --config playwright/playwright.config.js",
        "test": "pnpm vitest && pnpm playwright"
    },
    "peerDependencies": {
        "jquery": ">= 3"
    },
    "devDependencies": {
        "@babel/cli": "^8.0.4",
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-typescript": "^8.0.1",
        "@cspell/eslint-plugin": "^10.0.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/user-event": "^14.6.5",
        "@types/debug": "^4.1.13",
        "@types/jquery": "^4.0.1",
        "@types/node": "^26.2.0",
        "@vitest/coverage-istanbul": "^4.1.11",
        "@vitest/eslint-plugin": "^1.6.27",
        "autoprefixer": "^10.5.4",
        "axe-core": "^4.13.0",
        "babel-plugin-istanbul": "^8.0.0",
        "eslint": "^10.8.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jest-dom": "^5.10.1",
        "eslint-plugin-jest-extended": "github:Aesthermortis/eslint-plugin-jest-extended#v4.0.0",
        "eslint-plugin-perfectionist": "^5.10.1",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-testing-library": "^7.16.2",
        "jest-extended": "^7.0.0",
        "jsdom": "^30.0.1",
        "jsdom-testing-mocks": "^1.16.0",
        "jsonfile": "^6.2.1",
        "lodash": "^4.18.1",
        "msw": "^2.15.0",
        "postcss": "^8.5.26",
        "postcss-cli": "^11.0.1",
        "postcss-import": "^17.0.0",
        "postcss-load-config": "^6.0.1",
        "postcss-nested": "^8.0.1",
        "prettier": "^3.9.6",
        "rollup": "^4.62.4",
        "rollup-plugin-serve": "^3.0.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.11"
    }
}
