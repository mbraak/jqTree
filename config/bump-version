#!/bin/sh
# Bump the jqTree version in every file that contains it, then rebuild the
# distribution files so tree.jquery.js and friends carry the new version too.
# Usage: pnpm bump-version 1.9.2

set -e

new_version="$1"

if [ -z "$new_version" ]; then
    echo "Usage: pnpm bump-version <new-version>" >&2
    exit 1
fi

case "$new_version" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *)
        echo "Version must look like 1.2.3, got '$new_version'" >&2
        exit 1
        ;;
esac

old_version=$(node -p "require('./package.json').version")

if [ "$old_version" = "$new_version" ]; then
    echo "Version is already $new_version" >&2
    exit 1
fi

replace() {
    file="$1"
    pattern="$2"

    if ! grep -q "$pattern" "$file"; then
        echo "Could not find version $old_version in $file" >&2
        exit 1
    fi

    sed -i.bak "s/$pattern/\\1$new_version/" "$file"
    rm "$file.bak"
    echo "Updated $file"
}

old_pattern=$(echo "$old_version" | sed 's/\./\\./g')
new_pattern=$(echo "$new_version" | sed 's/\./\\./g')

# Only touch the line that holds the jqTree version, so a dependency
# that happens to share the same version number is left alone.
replace package.json "\(\"version\": \"\)$old_pattern"
replace bower.json "\(\"version\": \"\)$old_pattern"
replace src/version.ts "\(const version = \"\)$old_pattern"
replace docs/_config.yml "\(jqtree_version: \)$old_pattern"

echo "Bumped $old_version -> $new_version"
echo
echo "Building distribution files..."
pnpm production

for file in tree.jquery.js tree.jquery.debug.js; do
    if ! grep -q "JqTree $new_pattern" "$file"; then
        echo "Built $file does not contain version $new_version" >&2
        exit 1
    fi
    echo "Built $file"
done

echo
echo "Next steps:"
echo "  git commit -am 'Release $new_version'"
echo "  git tag $new_version"
echo "  git push && git push --tags"
